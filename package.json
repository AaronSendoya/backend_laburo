{
  "name": "app-laburo",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@app-laburo/backend...",
    "dev:mobile": "npm --prefix apps/mobile run dev",
    "dev:mobile:tunnel": "npm --prefix apps/mobile run dev:tunnel",
    "lint:mobile": "npm --prefix apps/mobile run lint",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
