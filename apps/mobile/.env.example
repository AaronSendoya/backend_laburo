# Copiar a .env (no se commitea) y completar.
# EXPO_PUBLIC_* se embebe en el bundle en tiempo de build — ninguno de los dos
# valores de acá es "secreto" en el sentido de una clave privada del servidor;
# son datos de configuración del cliente, no credenciales de usuario.

# URL del backend desplegado (Vercel). En desarrollo, si se omite, cae a http://localhost:3000.
EXPO_PUBLIC_API_BASE_URL=https://tu-backend.vercel.app

# TIENE que ser exactamente el mismo valor que APP_CLIENT_SECRET en apps/backend/.env —
# si no coinciden, /auth/register siempre devuelve 401 aunque los datos estén bien.
EXPO_PUBLIC_APP_CLIENT_SECRET=change-me-to-a-random-string-at-least-16-chars
