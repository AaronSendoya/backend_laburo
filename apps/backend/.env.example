# Copiar a .env (no se commitea) y completar con los valores reales.

# Endpoint POOLED de Neon (con ?sslmode=require&pgbouncer=true) — usado en runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true

# Endpoint DIRECTO (sin pooler) — usado solo por drizzle-kit / el script de migraciones.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Firma los JWT de sesión (mín. 32 caracteres). Generar algo largo y aleatorio,
# ej: openssl rand -hex 32 — y NUNCA reusar el mismo valor entre entornos.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secreto compartido con la app móvil (mín. 16 caracteres) — la app lo manda solo,
# como header, en cada /auth/register. Filtra registros que no vengan de la app
# real sin que la persona tenga que escribir nada. Tiene que ser EL MISMO valor
# que EXPO_PUBLIC_APP_CLIENT_SECRET en apps/mobile/.env — si no coinciden, el
# registro desde la app falla. Generar con, ej: openssl rand -hex 16
APP_CLIENT_SECRET=change-me-to-a-random-string-at-least-16-chars

PORT=3000
NODE_ENV=development
